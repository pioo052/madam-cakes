# MADAM CAKES — Apache configuration

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve application internals
  RewriteRule ^(config|database|includes|logs|tools|docker)(/|$) - [F,L]
</IfModule>

# Block direct download of source/backup/docs files
<FilesMatch "\.(sql|log|ini|env|bak|old|md|sh|ya?ml)$">
  Require all denied
</FilesMatch>

# Deployment files are not part of the public site
<FilesMatch "^(Dockerfile|\.env.*)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Static asset caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css   "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
