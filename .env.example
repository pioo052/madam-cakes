# MADAM CAKES — copy to .env and replace every value before deploying.
# .env is excluded from the image and must never be committed.

# Port published on the host (put a TLS reverse proxy in front in production).
APP_PORT=8080

# Public URL the browser uses. Must match the host/port/domain visitors see.
APP_URL=http://localhost:8080

# production hides PHP errors from visitors and writes them to logs/error.log.
APP_ENV=production

# Set to 1 when visitors reach the site over HTTPS (for example behind a proxy),
# so the session cookie is marked Secure.
APP_HTTPS=0

# Database credentials. Use long random values.
DB_NAME=madam_cakes_db
DB_USER=madam
DB_PASS=change-me-strong-database-password
DB_ROOT_PASS=change-me-strong-root-password
